# Generate with `openssl rand -hex 32`
PAYLOAD_SECRET=

# Stripe test mode only. Leave unset to run pay-later checkout with no Stripe account.
# Live keys (sk_live_ / pk_live_) are rejected. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOKS_SIGNING_SECRET=

# Who sees Claim on a shop page.
# without-website (default) — only shops whose hasWebsite field is false
# off — hide Claim everywhere
# Claims are never shown when hasWebsite is true, and there is no Get Zumo CTA.
CLAIM_AUDIENCE=without-website
