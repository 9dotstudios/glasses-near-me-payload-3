{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "glasses-near-me-payload",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "glasses-near-me-payload-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "glasses-near-me-payload-media",
    },
  ],
}
