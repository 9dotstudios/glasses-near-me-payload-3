{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "glasses-near-me-payload",
  "account_id": "94068cc076ded5a2933285c09a5f9d0d",
  // Preview-only: workers.dev subdomain. Do not add routes or custom domains.
  "workers_dev": true,
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "4403dc2d-fbce-474c-b527-2c2e47eaec6b",
      "database_name": "glasses-near-me-payload-db",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "glasses-near-me-payload-media",
    },
  ],
}
